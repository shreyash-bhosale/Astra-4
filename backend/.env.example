# Server Configuration
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# Supabase PostgreSQL Database (Optional for remote persistence)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI Model
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-flash-latest

# Transactional Email Provider (Resend)
# Backend-only. DO NOT prefix with VITE_ or expose to client bundles.
RESEND_API_KEY=re_your_live_resend_api_key_here
EMAIL_FROM=ResolveAI Operations <notifications@your-verified-domain.com>
MANAGER_NOTIFICATION_EMAIL=manager@your-domain.com
