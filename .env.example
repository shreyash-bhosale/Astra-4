# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================

# Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE KEYS (Safe for frontend / browser - Row Level Security enabled)
# ------------------------------------------------------------------------------

# Publishable Key (New Supabase format: starts with sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Anon Public Key (Legacy JWT format: starts with eyJhbGciOi...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key_here

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE KEYS (NEVER expose to browser / frontend - Bypasses RLS)
# ------------------------------------------------------------------------------

# Service Role Key (Legacy JWT format: starts with eyJhbGciOi...)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi_your_service_role_key_here

# Secret Key (New Supabase format: starts with sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ==============================================================================
# AI INTEGRATION KEYS
# ==============================================================================

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (Optional - Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here
